generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Final role set (ADR 0010): the generic lifecycle module's MANAGER/ENGINEER
// are retired along with it. Everything below is the SOP domain's roles.
enum UserRole {
  ADMIN
  FINANCE
  PMO
  PRODUCT_DESIGNER
  ENGINEERING
  MANAGEMENT
  MERCHANDISER

  @@map("user_role")
}

enum ApprovalDecision {
  APPROVED
  REJECTED

  @@map("approval_decision")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String    @unique
  role               UserRole
  passwordHash       String    @map("password_hash")
  // Accounts are admin-managed only (ADR 0010/0011): deactivated, never hard
  // deleted - every SOP relation to User is onDelete: Restrict, so a real
  // delete would be blocked the moment the user had created/confirmed/
  // approved anything anyway.
  isActive           Boolean   @default(true) @map("is_active")
  // Set on creation and on every password change, self-service or admin
  // reset (ADR 0011). Null means "never changed since creation" (pre-existing
  // seeded rows). authenticate rejects a token issued before this, so a
  // change invalidates every session the old password was logged into - not
  // just future logins.
  passwordChangedAt  DateTime? @map("password_changed_at")
  // Set by an admin password reset, cleared by the user's own next
  // successful change-password (ADR 0011). While true, every endpoint except
  // GET /auth/me and POST /auth/change-password returns 403 - a reset issues
  // a one-time temporary password, not a password an admin chose, so the
  // user must be the one to pick a real one before doing anything else.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")

  projectsCreated          Project[]              @relation("ProjectCreator")
  techPacksCreated         TechPack[]             @relation("TechPackCreator")
  techPacksVoided          TechPack[]             @relation("TechPackVoider")
  techPackVersionsUploaded TechPackVersion[]      @relation("TechPackVersionUploader")
  techPackRemarks          TechPackRemark[]       @relation("TechPackRemarkAuthor")
  techPackConfirmations    TechPackConfirmation[] @relation("TechPackConfirmer")
  techPackApprovals        TechPackApproval[]     @relation("TechPackApprover")
  attachmentsUploaded      Attachment[]           @relation("AttachmentUploader")
  sessions                 UserSession[]
  projectMemberships       ProjectMember[]        @relation("ProjectMemberUser")
  projectMembersAdded      ProjectMember[]        @relation("ProjectMemberAdder")
  projectMemberHistoryFor  ProjectMemberHistory[] @relation("ProjectMemberHistoryUser")
  projectMemberHistoryBy   ProjectMemberHistory[] @relation("ProjectMemberHistoryActor")
  notifications            Notification[]

  // Slice B (ADR 0015) - Proto Request Stage 4 / Proto Work Stage 5.
  manufacturersCreated       ManufacturerMaster[]            @relation("ManufacturerCreator")
  manufacturerAssignments    ProtoRequest[]                  @relation("ProtoRequestManufacturerAssigner")
  protoRequestConfirmations  ProtoRequest[]                  @relation("ProtoRequestConfirmer")
  protoWorkAssignedTo        ProtoWork[]                     @relation("ProtoWorkMerchandiser")
  protoWorkAssignedBy        ProtoWork[]                     @relation("ProtoWorkAssigner")
  protoWorkCompletions       ProtoWork[]                     @relation("ProtoWorkCompleter")
  protoWorkDeliveryConfirmed ProtoWorkDeliveryConfirmation[] @relation("ProtoWorkDeliveryConfirmer")
  protoWorkUpdatesAuthored   ProtoWorkUpdate[]               @relation("ProtoWorkUpdateAuthor")

  @@map("users")
}

// A refresh-token session (ADR 0012). Named UserSession, not Session, so it
// isn't confused with apps/web's own `Session` type (the in-memory
// access-token + user pair) when both come up in the same discussion -
// they're different concepts in different apps.
//
// onDelete: Cascade, not Restrict like the SOP domain (ADR 0006, point 9) -
// this is ephemeral auth state, not an audit trail; there is nothing here
// worth blocking a (currently nonexistent) user delete over.
model UserSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the current rotating secret - not argon2: that algorithm's
  // slow, memory-hard hashing exists to resist guessing a human password,
  // which is irrelevant for a 256-bit random value, and would needlessly
  // slow down every refresh call.
  tokenHash         String    @map("token_hash")
  // The hash this session had *before* its most recent rotation, and when
  // that rotation happened. Lets a second tab that raced the first (same
  // old secret, already rotated away by the time this one arrives) succeed
  // instead of being treated as token reuse - but only within a short grace
  // window (see ROTATION_GRACE_WINDOW_MS in sessionService.ts), so an
  // actually-stolen, already-superseded token still gets caught.
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at")
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at")
  // Updated only on a successful refresh, not on every API call (ADR 0012) -
  // idle timeout measures how long it's been since the session was last
  // actively kept alive, not general API traffic.
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  // Absolute limit, fixed at creation, never extended by rotation.
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  @@index([userId])
  @@map("user_sessions")
}

// =============================================================================
// SOP domain (ADR 0006, ADR 0007, ADR 0008) - Project, Tech Pack + versions,
// Engineering confirmation / Management approval, Proto Request. Every
// relation here uses onDelete: Restrict (ADR 0006, point 9).
//
// `code` columns default to a Postgres sequence + format_code() call via
// dbgenerated() - see ADR 0006 for the exact migration-SQL procedure this
// requires (sequences and the function must exist before these defaults do).
// =============================================================================

enum ProjectPhase {
  PROTO
  BULK

  @@map("project_phase")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED

  @@map("project_status")
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  code             String        @unique @default(dbgenerated("format_code('PRJ'::text, nextval('prj_code_seq'::regclass))"))
  name             String
  productName      String        @map("product_name")
  productCategory  String?       @map("product_category")
  phase            ProjectPhase  @default(PROTO)
  status           ProjectStatus @default(ACTIVE)
  protoCompletedAt DateTime?     @map("proto_completed_at")
  completedAt      DateTime?     @map("completed_at")
  createdById      String        @map("created_by") @db.Uuid
  createdBy        User          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now()) @map("created_at")

  techPacks     TechPack[]
  protoRequests ProtoRequest[]
  protoWork     ProtoWork[]
  members       ProjectMember[]
  memberHistory ProjectMemberHistory[]

  @@map("projects")
}

enum ProjectMemberAction {
  ADDED
  REMOVED

  @@map("project_member_action")
}

// Layer A of ADR 0013's visibility model: who may see a Project at all (and,
// transitively, its Tech Packs/Proto Requests - layer B, within services/
// visibility.ts, further narrows *which parts* once a role clears this gate).
// ADMIN/PMO/MANAGEMENT bypass this table entirely (see-all roles); every
// other role must have a row here. onDelete: Restrict, not Cascade like
// UserSession - this is audit-relevant membership data, not ephemeral auth
// state (ADR 0006 point 9's default, same as the rest of the SOP domain).
model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  addedById String   @map("added_by") @db.Uuid
  addedBy   User     @relation("ProjectMemberAdder", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt   DateTime @default(now()) @map("added_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// Append-only audit trail alongside ProjectMember's current-state table -
// same "current state table + paired history table" shape this project's
// design principles have called for since the very first handoff doc
// (Section 3), just not needed again until now.
model ProjectMemberHistory {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @map("project_id") @db.Uuid
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String              @map("user_id") @db.Uuid
  user      User                @relation("ProjectMemberHistoryUser", fields: [userId], references: [id], onDelete: Restrict)
  action    ProjectMemberAction
  byId      String              @map("by") @db.Uuid
  by        User                @relation("ProjectMemberHistoryActor", fields: [byId], references: [id], onDelete: Restrict)
  at        DateTime            @default(now())

  @@index([projectId])
  @@map("project_member_history")
}

// One row per TP number (parent); revisions are child TechPackVersion rows.
// A Management rejection voids this row (voidedAt/voidedById/voidReason) and
// a new TechPack is created under the same Project, linked back via
// supersedesId on the new row.
model TechPack {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @default(dbgenerated("format_code('TP'::text, nextval('tp_code_seq'::regclass))"))
  projectId   String       @map("project_id") @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Copied from Project.phase at creation time, not read live - see ADR 0006
  // point 6 (a later Proto->Bulk move on the Project must not retroactively
  // reclassify a Tech Pack already reviewed under the old phase).
  phase       ProjectPhase @default(PROTO)
  createdById String       @map("created_by") @db.Uuid
  createdBy   User         @relation("TechPackCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @map("created_at")

  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by") @db.Uuid
  voidedBy   User?     @relation("TechPackVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?   @map("void_reason")

  // Points from the new TechPack back at the one it replaced. Unique: a
  // voided TechPack has at most one successor.
  supersedesId String?   @unique @map("supersedes_id") @db.Uuid
  supersedes   TechPack? @relation("TechPackSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy TechPack? @relation("TechPackSupersession")

  versions TechPackVersion[]

  @@index([projectId])
  @@map("tech_packs")
}

model TechPackVersion {
  id            String   @id @default(uuid()) @db.Uuid
  techPackId    String   @map("tech_pack_id") @db.Uuid
  techPack      TechPack @relation(fields: [techPackId], references: [id], onDelete: Restrict)
  versionNumber Int      @map("version_number")
  notes         String?
  uploadedById  String   @map("uploaded_by") @db.Uuid
  uploadedBy    User     @relation("TechPackVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  attachments   Attachment[]
  remarks       TechPackRemark[]
  confirmation  TechPackConfirmation?
  approval      TechPackApproval?
  protoRequests ProtoRequest[]

  @@unique([techPackId, versionNumber])
  @@map("tech_pack_versions")
}

// File metadata only - bytes live behind the storage interface (ADR 0008).
// One nullable FK per attachable entity (not a polymorphic owner_type/
// owner_id pair); more owner columns are added here as later slices need
// them (e.g. a purchase order in Slice B).
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedById String   @map("uploaded_by") @db.Uuid
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  techPackVersionId String?          @map("tech_pack_version_id") @db.Uuid
  techPackVersion   TechPackVersion? @relation(fields: [techPackVersionId], references: [id], onDelete: Restrict)

  // Slice B (ADR 0015): the PO Finance uploads against a ProtoRequest -
  // @unique enforces one PO per ProtoRequest at the DB level, same shape as
  // TechPackConfirmation.techPackVersionId.
  protoRequestId String?       @unique @map("proto_request_id") @db.Uuid
  protoRequest   ProtoRequest? @relation("ProtoRequestPo", fields: [protoRequestId], references: [id], onDelete: Restrict)

  @@index([techPackVersionId])
  @@map("attachments")
}

// The system chat/remarks thread on one version during Engineering's review
// (SOP Stage 3). Scoped functional data, not a generic free-form comments
// table.
model TechPackRemark {
  id                String          @id @default(uuid()) @db.Uuid
  techPackVersionId String          @map("tech_pack_version_id") @db.Uuid
  techPackVersion   TechPackVersion @relation(fields: [techPackVersionId], references: [id], onDelete: Restrict)
  authorId          String          @map("author_id") @db.Uuid
  author            User            @relation("TechPackRemarkAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body              String
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([techPackVersionId])
  @@map("tech_pack_remarks")
}

// Engineering's sign-off on one specific version. Unique on the version - a
// version is confirmed at most once; a further change request is a
// TechPackRemark on a new version, not a second row here.
model TechPackConfirmation {
  id                String          @id @default(uuid()) @db.Uuid
  techPackVersionId String          @unique @map("tech_pack_version_id") @db.Uuid
  techPackVersion   TechPackVersion @relation(fields: [techPackVersionId], references: [id], onDelete: Restrict)
  confirmedById     String          @map("confirmed_by") @db.Uuid
  confirmedBy       User            @relation("TechPackConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt       DateTime        @default(now()) @map("confirmed_at")

  @@map("tech_pack_confirmations")
}

// Management's final decision. Service enforces this can only target the
// latest version of the TechPack, and only once that version has a
// TechPackConfirmation. APPROVED -> service creates a ProtoRequest; REJECTED
// -> service voids this TechPack and creates a new one under the same
// Project (supersedesId links them).
model TechPackApproval {
  id                String           @id @default(uuid()) @db.Uuid
  techPackVersionId String           @unique @map("tech_pack_version_id") @db.Uuid
  techPackVersion   TechPackVersion  @relation(fields: [techPackVersionId], references: [id], onDelete: Restrict)
  decision          ApprovalDecision
  decidedById       String           @map("decided_by") @db.Uuid
  decidedBy         User             @relation("TechPackApprover", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt         DateTime         @default(now()) @map("decided_at")
  notes             String?

  @@map("tech_pack_approvals")
}

// Stage 3's output / Stage 4's subject - one record whose lifecycle spans
// both (ADR 0006, point 8). Slice A writes only what Stage 3 produces; Slice
// B adds manufacturer/PO/confirmation fields to this same table. No
// techPackId column - the TechPack is reachable via techPackVersion.techPack,
// so a second FK that has to agree with the first earns no query here.
model ProtoRequest {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique @default(dbgenerated("format_code('PR'::text, nextval('pr_code_seq'::regclass))"))
  projectId         String          @map("project_id") @db.Uuid
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  techPackVersionId String          @map("tech_pack_version_id") @db.Uuid
  techPackVersion   TechPackVersion @relation(fields: [techPackVersionId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now()) @map("created_at")

  // -------------------------------------------------------------------------
  // Slice B (ADR 0015), Stage 4 - populated progressively (PMO assigns a
  // manufacturer, Finance uploads the PO, PMO confirms), locked in by
  // `confirmedAt`. All nullable rather than a status enum, for the same
  // reason TechPackConfirmation/TechPackApproval aren't a status flag on
  // TechPack (ADR 0006): each step needs its own who/when, not just a state.
  // -------------------------------------------------------------------------
  manufacturerId           String?             @map("manufacturer_id") @db.Uuid
  manufacturer             ManufacturerMaster? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  manufacturerAssignedAt   DateTime?           @map("manufacturer_assigned_at")
  manufacturerAssignedById String?             @map("manufacturer_assigned_by") @db.Uuid
  manufacturerAssignedBy   User?               @relation("ProtoRequestManufacturerAssigner", fields: [manufacturerAssignedById], references: [id], onDelete: Restrict)
  // Step 16's order confirmation / commercial negotiation note.
  commercialNotes          String?             @map("commercial_notes")

  // The PO Finance uploads (step 17) - back-relation only; Attachment carries
  // the owning FK (protoRequestId), same "owner column lives on Attachment"
  // pattern as techPackVersionId. uploadedAt/uploadedBy are read off the
  // Attachment itself, not duplicated here.
  poAttachment Attachment? @relation("ProtoRequestPo")

  // Step 18/19: the agreed delivery schedule and PMO's confirmation note,
  // locked in when the Proto Request is confirmed and ProtoWork is created.
  agreedDeliveryDate DateTime? @map("agreed_delivery_date") @db.Date
  confirmationNote   String?   @map("confirmation_note")
  confirmedAt        DateTime? @map("confirmed_at")
  confirmedById      String?   @map("confirmed_by") @db.Uuid
  confirmedBy        User?     @relation("ProtoRequestConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  protoWork ProtoWork?

  @@index([projectId, techPackVersionId])
  @@map("proto_requests")
}

// =============================================================================
// Slice B (ADR 0015) - Manufacturer master, Proto Request Stage 4 fields
// (above), Proto Work Stage 5. Same onDelete: Restrict standing rule as the
// rest of this domain (ADR 0006 point 9).
// =============================================================================

// Master data, not a `users` row (ADR 0006 point 7) - staff select a
// Manufacturer and record activity against it, no portal account for the
// MVP. Deliberately no `code`: the SOP's own ID/traceability table (section
// 12) lists one for every lifecycle record it names and not for
// Manufacturer - a signal it isn't part of that chain, same framing as
// "master data, not a lifecycle entity". Deactivated, never deleted, like
// User - every FK to it is onDelete: Restrict.
model ManufacturerMaster {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by") @db.Uuid
  createdBy    User     @relation("ManufacturerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  protoRequests ProtoRequest[]

  @@map("manufacturer_masters")
}

enum ProtoWorkStatus {
  QUEUED
  ASSIGNED
  COMPLETED

  @@map("proto_work_status")
}

// Stage 5's output - one row per confirmed ProtoRequest (1:1), created in
// the same transaction as ProtoRequest.confirm. `projectId` is denormalized
// directly, same choice ProtoRequest itself already made (reachable via
// protoRequest.project too, but every list query at this level filters by
// project, same as every sibling table).
model ProtoWork {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique @default(dbgenerated("format_code('PW'::text, nextval('pw_code_seq'::regclass))"))
  projectId      String          @map("project_id") @db.Uuid
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  protoRequestId String          @unique @map("proto_request_id") @db.Uuid
  protoRequest   ProtoRequest    @relation(fields: [protoRequestId], references: [id], onDelete: Restrict)
  status         ProtoWorkStatus @default(QUEUED)

  // Step 20: PMO assigns from the Work Queue. Workload-tracking metadata,
  // not an access-control boundary - completing/updating this ProtoWork
  // isn't restricted to this specific person (see ADR 0015).
  assignedMerchandiserId String?   @map("assigned_merchandiser_id") @db.Uuid
  assignedMerchandiser   User?     @relation("ProtoWorkMerchandiser", fields: [assignedMerchandiserId], references: [id], onDelete: Restrict)
  assignedAt             DateTime? @map("assigned_at")
  assignedById           String?   @map("assigned_by") @db.Uuid
  assignedBy             User?     @relation("ProtoWorkAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  // Step 22's "periodic delivery-date confirmation" - current state here,
  // paired with the append-only ProtoWorkDeliveryConfirmation history below.
  // Seeded from protoRequest.agreedDeliveryDate when this row is created.
  currentDeliveryDate DateTime @map("current_delivery_date") @db.Date

  // Step 23.
  completedAt   DateTime? @map("completed_at")
  completedById String?   @map("completed_by") @db.Uuid
  completedBy   User?     @relation("ProtoWorkCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  deliveryConfirmations ProtoWorkDeliveryConfirmation[]
  updates               ProtoWorkUpdate[]

  @@index([projectId])
  @@map("proto_work")
}

// Append-only history paired with ProtoWork.currentDeliveryDate as current
// state - same "current-state table + paired history table" shape as
// ProjectMember/ProjectMemberHistory and TechPack's void fields.
model ProtoWorkDeliveryConfirmation {
  id            String    @id @default(uuid()) @db.Uuid
  protoWorkId   String    @map("proto_work_id") @db.Uuid
  protoWork     ProtoWork @relation(fields: [protoWorkId], references: [id], onDelete: Restrict)
  deliveryDate  DateTime  @map("delivery_date") @db.Date
  confirmedById String    @map("confirmed_by") @db.Uuid
  confirmedBy   User      @relation("ProtoWorkDeliveryConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  notes         String?
  confirmedAt   DateTime  @default(now()) @map("confirmed_at")

  @@index([protoWorkId])
  @@map("proto_work_delivery_confirmations")
}

// Step 21's "remarks/chat updates" - same scoped-functional-table shape as
// TechPackRemark, not the generic `comments` table ADR 0004 deferred.
model ProtoWorkUpdate {
  id          String    @id @default(uuid()) @db.Uuid
  protoWorkId String    @map("proto_work_id") @db.Uuid
  protoWork   ProtoWork @relation(fields: [protoWorkId], references: [id], onDelete: Restrict)
  authorId    String    @map("author_id") @db.Uuid
  author      User      @relation("ProtoWorkUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([protoWorkId])
  @@map("proto_work_updates")
}

// ADR 0014: a stored, append-only event log, written in the same
// transaction as the action that caused it. Not polymorphic - `message`
// and `link` are a fixed-at-creation snapshot (same "redundant human-
// readable snapshot" precedent as TechPack.voidReason), so a reader never
// needs to join back through whatever it refers to just to render it.
// onDelete: Restrict, not Cascade like UserSession - this is audit-relevant
// event history, not ephemeral auth state (ADR 0006 point 9's default).
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  type        NotificationType
  message     String
  link        String
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

enum NotificationType {
  TECH_PACK_VERSION_UPLOADED
  TECH_PACK_REMARK_ADDED
  TECH_PACK_VERSION_CONFIRMED
  TECH_PACK_VERSION_APPROVED
  TECH_PACK_VERSION_REJECTED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED

  // Slice B (ADR 0015).
  MANUFACTURER_ASSIGNED
  PROTO_REQUEST_PO_UPLOADED
  PROTO_WORK_QUEUED
  PROTO_WORK_ASSIGNED
  PROTO_WORK_COMPLETED

  @@map("notification_type")
}

PORT=4000
DATABASE_URL=postgresql://kyvera:kyvera@localhost:5432/kyvera?schema=public

# The database `npm test` uses - entirely separate from DATABASE_URL above, so
# a test run can never touch dev data. tests/globalSetup.ts creates it if it
# doesn't exist, runs migrations against it, and truncates+reseeds it before
# every run; its database name must end in "_test" or the test run refuses to
# start (see tests/testEnv.ts). Optional; defaults to the value below.
# TEST_DATABASE_URL=postgresql://kyvera:kyvera@localhost:5432/kyvera_test?schema=public

# Signs and verifies access tokens (HS256). Required, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Anyone with this value can mint a valid token for any user, so use a different
# value per environment and never commit a real one.
JWT_SECRET=

# Browser origins allowed to call this API (CORS): comma-separated, bare origins
# only (scheme + host + optional port; no path or trailing slash), never "*".
# Defaults to the Vite dev server. If Vite starts on another port because 5173 is
# taken, add that origin here or every browser request will be blocked.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Access token lifetime in seconds. Optional; defaults to 3600 (1 hour).
# There is no refresh flow yet, so clients log in again when it expires.
# JWT_EXPIRES_IN_SECONDS=3600

# Password given to seeded dev users (db:seed) whose stored password isn't a
# real hash yet. Dev data only — never seed a shared environment with this.
# SEED_USER_PASSWORD=kyvera-dev-password

# Where LocalDiskStorage (ADR 0008) writes attachment bytes. Relative paths
# resolve against apps/api/. Gitignored; not served statically - files are only
# reachable through an authenticated download endpoint.
# UPLOADS_DIR=uploads
